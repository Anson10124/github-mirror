# Copy this file to .env and fill in the values. Never commit .env.

# Required
GITHUB_TOKEN=
GITLAB_TOKEN=
GITLAB_NAMESPACE=your-gitlab-username

# Optional (defaults shown)
# GITLAB_URL=https://gitlab.com
# SYNC_INTERVAL=1h
# INCLUDE_FORKS=false
# INCLUDE_ARCHIVED=true
# EXCLUDE_REPOS=
# GITLAB_VISIBILITY=private
# ENABLE_LFS=false
# DRY_RUN=false
# ADOPT_EXISTING=false
